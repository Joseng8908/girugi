# Copy to .env for local dev. In prod/container, inject these as env vars.
# Only ANTHROPIC_API_KEY and ALLOWED_ORIGIN matter for real use.

# Bind address. Empty HOST = all interfaces (correct for containers).
HOST=
PORT=8080

# Required for real LLM calls. Without it /api/chat returns 503 (server still boots).
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-haiku-4-5-20251001.
# NOTE: prompts were tuned on GPT-4o; measure JSON-conformance after switching (spec §8).
MODEL=claude-haiku-4-5-20251001

# CORS: the frontend origin. "*" only for local dev — set the real origin in prod.
# HTTPS is required in prod: a Vercel (https) frontend blocks an http API.
ALLOWED_ORIGIN=*

# Where prompt files live. Defaults to ./prompts (container image uses /prompts).
PROMPTS_DIR=./prompts
