# Copy to .env for local dev. In prod/container, inject these as env vars.
# Only the provider API key and ALLOWED_ORIGIN matter for real use.

# Bind address. Empty HOST = all interfaces (correct for containers).
HOST=
PORT=8080

# LLM provider: openai (default) | anthropic. Prompts are tuned on GPT-4o.
LLM_PROVIDER=openai

# API key for the SELECTED provider. Without it /api/chat returns 503 (server still boots).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional. Default per provider: openai -> gpt-4o, anthropic -> claude-haiku-4-5-20251001.
MODEL=

# CORS: the frontend origin. "*" only for local dev — set the real origin in prod.
# HTTPS is required in prod: a Vercel (https) frontend blocks an http API.
ALLOWED_ORIGIN=*

# Where prompt files live. Defaults to ./prompts (container image uses /prompts).
PROMPTS_DIR=./prompts
